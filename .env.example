# Flask Configuration
SECRET_KEY=change-this-to-a-secure-random-key-in-production
FLASK_ENV=development
PORT=5000
SESSION_COOKIE_SECURE=false

# Deployment & CORS Configuration
FRONTEND_URL=http://localhost:5000
CORS_ALLOWED_ORIGINS=http://localhost:*,http://127.0.0.1:*,https://*.vercel.app

# Database (Set USE_SQLITE=true for demo/cloud free tier without MySQL)
USE_SQLITE=false
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password_here
MYSQL_DB=pii_redaction_system

# Tesseract OCR Executable Path
# Windows:
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
# Linux:
# TESSERACT_CMD=/usr/bin/tesseract
# macOS:
# TESSERACT_CMD=/opt/homebrew/bin/tesseract
