# Flask Configuration
SECRET_KEY=change-this-to-a-secure-random-key-in-production
FLASK_ENV=development
PORT=5000
SESSION_COOKIE_SECURE=false

# Deployment & CORS Configuration
FRONTEND_URL=http://localhost:5000
CORS_ALLOWED_ORIGINS=http://localhost:*,http://127.0.0.1:*,https://*.vercel.app

# Database Configuration
# 1. Local Development (Default): MySQL
# Keep DATABASE_URL empty and USE_SQLITE=false to use local MySQL.
USE_SQLITE=false
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password_here
MYSQL_DB=pii_redaction_system
MYSQL_POOL_SIZE=10

# 2. Production / Cloud: External PostgreSQL (e.g. Neon, Supabase)
# Set DATABASE_URL in your cloud environment (e.g. Render Dashboard).
# PrivLock connects to PostgreSQL via ThreadedConnectionPool when DATABASE_URL is present.
# Failure to connect to PostgreSQL in production will report an error and will NOT silently fall back to SQLite.
# DATABASE_URL=postgresql://username:password@ep-xyz.us-east-2.aws.neon.tech/neondb?sslmode=require
# POSTGRES_POOL_SIZE=5

# 3. Automated Testing / Explicit Fallback: SQLite
# Set USE_SQLITE=true to explicitly force embedded SQLite storage (used for isolated unit tests).
# USE_SQLITE=true

# Tesseract OCR Executable Path
# Windows:
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
# Linux:
# TESSERACT_CMD=/usr/bin/tesseract
# macOS:
# TESSERACT_CMD=/opt/homebrew/bin/tesseract
